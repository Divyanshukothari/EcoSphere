# Copy this file to .env and fill in your values before running docker compose
# docker compose reads this automatically from the project root

# Required: Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults are already set in docker-compose.yml)
JWT_SECRET=supersecretjwtkey_for_ecosphere_change_in_prod
DAILY_MESSAGE_LIMIT=10
